<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_clinicflow_pet_tree" model="ir.ui.view">
        <field name="name">clinicflow.pet.list</field>
        <field name="model">clinicflow.pet</field>
        <field name="arch" type="xml">
            <list string="Pets">
                <field name="name"/>
                <field name="species"/>
                <field name="breed"/>
                <field name="gender"/>
                <field name="age_display" string="Age"/>
                <field name="owner_id"/>
                <field name="last_weight"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_clinicflow_pet_search" model="ir.ui.view">
        <field name="name">clinicflow.pet.search</field>
        <field name="model">clinicflow.pet</field>
        <field name="arch" type="xml">
            <search string="Search Pets">
                <field name="name" string="Pet Name"/>
                <field name="owner_id" string="Owner"/>
                <field name="microchip" string="Microchip"/>
                <filter string="Dogs" name="dogs" domain="[('species', '=', 'dog')]"/>
                <filter string="Cats" name="cats" domain="[('species', '=', 'cat')]"/>
                <separator/>
                <filter string="Group by Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                <filter string="Group by Species" name="group_species" context="{'group_by': 'species'}"/>
            </search>
        </field>
    </record>

    <!-- Form View (Patient 360 Workspace Base) -->
    <record id="view_clinicflow_pet_form" model="ir.ui.view">
        <field name="name">clinicflow.pet.form</field>
        <field name="model">clinicflow.pet</field>
        <field name="arch" type="xml">
            <form string="Pet">
                <header>
                    <!-- Injected by sub-modules -->
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_weight_history" type="object" class="oe_stat_button" icon="fa-balance-scale">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="last_weight_display"/></span>
                                <span class="o_stat_text">Weight Logs (<field name="weight_count"/>)</span>
                            </div>
                        </button>
                    </div>

                    <field name="photo" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'photo'}"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Pet Name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bella"/>
                        </h1>
                    </div>

                    <!-- Alerts & Warnings -->
                    <div class="alert alert-danger mb-2 p-2" role="alert" invisible="not alerts" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; font-size: 14px; font-weight: bold;">
                        <span class="fa fa-exclamation-triangle me-2"/>CRITICAL ALERT: <field name="alerts" readonly="1"/>
                    </div>
                    <div class="alert alert-warning mb-2 p-2" role="alert" invisible="not allergies" style="color: #856404; background-color: #fff3cd; border-color: #ffeeba; font-size: 14px; font-weight: bold;">
                        <span class="fa fa-warning me-2"/>ALLERGY WARNING: <field name="allergies" readonly="1"/>
                    </div>

                    <group>
                        <group string="Quick Details">
                            <field name="species"/>
                            <field name="breed"/>
                            <field name="gender"/>
                            <field name="age_display" readonly="1"/>
                        </group>
                        <group string="Owner &amp; Warnings">
                            <field name="owner_id"/>
                            <field name="emergency_contact"/>
                            <field name="alerts" placeholder="No clinical alerts" style="color: red; font-weight: bold;"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Profile" name="profile">
                            <group string="Weight History">
                                <field name="weight_ids" nolabel="1">
                                    <list string="Weight Records" editable="bottom">
                                        <field name="date"/>
                                        <field name="weight"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </group>
                            <group string="General Info">
                                <field name="notes" placeholder="Enter other general notes here..."/>
                                <field name="microchip"/>
                            </group>
                        </page>

                        <page string="Medical History" name="medical_history">
                            <group>
                                <field name="chronic_conditions" placeholder="e.g. Diabetes, Hip Dysplasia..."/>
                                <field name="allergies" placeholder="e.g. Penicillin allergy, Chicken protein..."/>
                                <field name="surgical_history" placeholder="e.g. Neutered on 2024-05-12, Fracture repair on 2025-08-01..."/>
                            </group>
                        </page>

                        <page string="Documents" name="documents">
                            <field name="attachment_ids">
                                <list string="Documents" editable="bottom">
                                    <field name="name"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Patients -->
    <record id="action_clinicflow_pet" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clinicflow.pet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new pet patient!
            </p>
        </field>
    </record>

    <!-- Recent Patients Server Action -->
    <record id="action_clinicflow_pet_recent" model="ir.actions.server">
        <field name="name">Recent Patients</field>
        <field name="model_id" ref="model_clinicflow_pet"/>
        <field name="state">code</field>
        <field name="code">
            action = env.user.action_view_recent_pets()
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_clinicflow_patients" name="Patients" parent="clinicflow_core.menu_clinicflow_root" action="action_clinicflow_pet" sequence="10"/>
    <menuitem id="menu_clinicflow_patients_recent" name="Recent Patients" parent="clinicflow_core.menu_clinicflow_root" action="action_clinicflow_pet_recent" sequence="12"/>
</odoo>
