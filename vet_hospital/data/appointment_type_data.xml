<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Appointment Types -->
        <record id="appointment_type_wellness" model="vet.appointment_type">
            <field name="name">Wellness Check</field>
            <field name="description">Annual or routine wellness examination</field>
            <field name="duration">30</field>
            <field name="price">75.00</field>
            <field name="category">wellness</field>
            <field name="active">True</field>
        </record>

        <record id="appointment_type_vaccination" model="vet.appointment_type">
            <field name="name">Vaccination</field>
            <field name="description">Vaccine administration</field>
            <field name="duration">20</field>
            <field name="price">50.00</field>
            <field name="category">vaccination</field>
            <field name="active">True</field>
        </record>

        <record id="appointment_type_dental" model="vet.appointment_type">
            <field name="name">Dental Cleaning</field>
            <field name="description">Dental examination and cleaning</field>
            <field name="duration">60</field>
            <field name="price">150.00</field>
            <field name="category">dental</field>
            <field name="active">True</field>
        </record>

        <record id="appointment_type_surgery" model="vet.appointment_type">
            <field name="name">Surgery</field>
            <field name="description">Surgical procedure</field>
            <field name="duration">120</field>
            <field name="price">350.00</field>
            <field name="category">surgery</field>
            <field name="active">True</field>
        </record>

        <record id="appointment_type_treatment" model="vet.appointment_type">
            <field name="name">Medical Treatment</field>
            <field name="description">Medical treatment for existing conditions</field>
            <field name="duration">45</field>
            <field name="price">100.00</field>
            <field name="category">treatment</field>
            <field name="active">True</field>
        </record>

        <record id="appointment_type_followup" model="vet.appointment_type">
            <field name="name">Follow-up Visit</field>
            <field name="description">Post-treatment follow-up examination</field>
            <field name="duration">20</field>
            <field name="price">50.00</field>
            <field name="category">follow_up</field>
            <field name="active">True</field>
        </record>

        <record id="appointment_type_emergency" model="vet.appointment_type">
            <field name="name">Emergency</field>
            <field name="description">Emergency veterinary care</field>
            <field name="duration">45</field>
            <field name="price">200.00</field>
            <field name="category">emergency</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence for Models -->
        <record id="seq_vet_appointment" model="ir.sequence">
            <field name="name">Veterinary Appointment</field>
            <field name="code">vet.appointment</field>
            <field name="prefix">APT/%(year)s%(month)s/</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_vet_medical_record" model="ir.sequence">
            <field name="name">Medical Record</field>
            <field name="code">vet.medical_record</field>
            <field name="prefix">MR/%(year)s%(month)s/</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_vet_prescription" model="ir.sequence">
            <field name="name">Prescription</field>
            <field name="code">vet.prescription</field>
            <field name="prefix">RX/%(year)s%(month)s/</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
