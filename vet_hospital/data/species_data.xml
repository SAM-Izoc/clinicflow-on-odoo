            <field name="life_expectancy">13</field>
        </record>

        <!-- Rabbit -->
        <record id="species_rabbit" model="vet.species">
            <field name="name">Rabbit</field>
            <field name="scientific_name">Oryctolagus cuniculus</field>
            <field name="description">Rabbits</field>
        </record>

        <record id="breed_holland_lop" model="vet.breed">
            <field name="name">Holland Lop</field>
            <field name="species_id" ref="species_rabbit"/>
            <field name="average_weight">1.8</field>
            <field name="life_expectancy">9</field>
        </record>

        <!-- Bird -->
        <record id="species_bird" model="vet.species">
            <field name="name">Bird</field>
            <field name="description">Various bird species</field>
        </record>

        <!-- Small Rodents -->
        <record id="species_rodent" model="vet.species">
            <field name="name">Small Rodent</field>
            <field name="description">Hamsters, Guinea Pigs, Rats, Mice</field>
        </record>

        <!-- Reptile -->
        <record id="species_reptile" model="vet.species">
            <field name="name">Reptile</field>
            <field name="description">Snakes, Lizards, Turtles</field>
        </record>
    </data>
</odoo>
