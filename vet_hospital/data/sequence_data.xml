<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_vet_appointment" model="ir.sequence">
        <field name="name">Veterinary Appointment</field>
        <field name="code">vet.appointment</field>
        <field name="prefix">APT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_vet_medical_record" model="ir.sequence">
        <field name="name">Veterinary Medical Record</field>
        <field name="code">vet.medical_record</field>
        <field name="prefix">MR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_vet_prescription" model="ir.sequence">
        <field name="name">Veterinary Prescription</field>
        <field name="code">vet.prescription</field>
        <field name="prefix">RX/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
