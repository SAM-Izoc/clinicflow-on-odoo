<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Patient Tree View -->
    <record id="view_vet_patient_tree" model="ir.ui.view">
        <field name="name">vet.patient.tree</field>
        <field name="model">vet.patient</field>
        <field name="arch" type="xml">
            <list string="Patients" sample="1">
                <field name="name" string="Pet Name"/>
                <field name="owner_id" string="Owner"/>
                <field name="species_id" string="Species"/>
                <field name="breed_id" string="Breed"/>
                <field name="gender"/>
                <field name="weight"/>
                <field name="status" decoration-danger="status == 'deceased'" decoration-success="status == 'active'"/>
                <field name="last_visit" string="Last Visit"/>
            </list>
        </field>
    </record>

    <!-- Patient Form View -->
    <record id="view_vet_patient_form" model="ir.ui.view">
        <field name="name">vet.patient.form</field>
        <field name="model">vet.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_view_appointments" type="object" string="View Appointments" class="oe_highlight"/>
                    <button name="action_view_medical_records" type="object" string="Medical Records" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field string="Appointments" name="total_appointments" widget="statinfo"/>
                        </button>
                        <button name="action_view_medical_records" type="object" class="oe_stat_button" icon="fa-file-text">
                            <field string="Medical Records" name="medical_record_ids" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Pet Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="microchip_id"/>
                            <field name="status" widget="radio"/>
                            <field name="date_deceased" invisible="status != 'deceased'"/>
                            <field name="photo" widget="image" class="oe_avatar"/>
                        </group>
                        <group string="Owner Information">
                            <field name="owner_id" required="1"/>
                            <field name="preferred_vet_id"/>
                            <field name="primary_provider_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Physical Information">
                            <group>
                                <group>
                                    <field name="species_id" required="1"/>
                                    <field name="breed_id"/>
                                    <field name="color"/>
                                </group>
                                <group>
                                    <field name="date_of_birth"/>
                                    <field name="age"/>
                                    <field name="gender"/>
                                </group>
                            </group>
                            <group string="Neutering/Spaying">
                                <field name="is_neutered"/>
                                <field name="neutered_date" invisible="not is_neutered"/>
                            </group>
                            <group string="Current Weight">
                                <field name="weight"/>
                                <field name="last_weight"/>
                            </group>
                        </page>

                        <page string="Medical Information">
                            <group>
                                <field name="allergies" placeholder="List any known allergies..."/>
                                <field name="medical_conditions" placeholder="Existing medical conditions..."/>
                                <field name="medications" placeholder="Current medications..."/>
                                <field name="diet" placeholder="Diet and feeding information..."/>
                            </group>
                        </page>

                        <page string="Appointments">
                            <field name="appointment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_time"/>
                                    <field name="vet_id"/>
                                    <field name="appointment_type_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Medical Records">
                            <field name="medical_record_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_time"/>
                                    <field name="vet_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Statistics">
                            <group>
                                <field name="total_appointments"/>
                                <field name="last_visit"/>
                                <field name="next_appointment"/>
                                <field name="total_invoiced"/>
                            </group>
                        </page>

                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes about this patient..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Patient Search View -->
    <record id="view_vet_patient_search" model="ir.ui.view">
        <field name="name">vet.patient.search</field>
        <field name="model">vet.patient</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name" string="Pet Name"/>
                <field name="owner_id" string="Owner"/>
                <field name="species_id"/>
                <field name="breed_id"/>
                <field name="microchip_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Inactive" name="inactive" domain="[('status', '=', 'inactive')]"/>
                <filter string="Deceased" name="deceased" domain="[('status', '=', 'deceased')]"/>
                <separator/>
                <group>
                    <filter string="Owner" name="owner" domain="[]" context="{'group_by': 'owner_id'}"/>
                    <filter string="Species" name="species" domain="[]" context="{'group_by': 'species_id'}"/>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Patient Action -->
    <record id="action_vet_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">vet.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vet_patient_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create the first patient record
            </p>
        </field>
    </record>

    <!-- Species & Breed Views -->
    <record id="view_vet_species_tree" model="ir.ui.view">
        <field name="name">vet.species.tree</field>
        <field name="model">vet.species</field>
        <field name="arch" type="xml">
            <list string="Species" editable="bottom">
                <field name="name"/>
                <field name="scientific_name"/>
            </list>
        </field>
    </record>

    <record id="view_vet_species_form" model="ir.ui.view">
        <field name="name">vet.species.form</field>
        <field name="model">vet.species</field>
        <field name="arch" type="xml">
            <form string="Species">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="scientific_name"/>
                        <field name="description"/>
                    </group>
                    <separator string="Breeds"/>
                    <field name="breed_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="average_weight"/>
                            <field name="life_expectancy"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vet_species" model="ir.actions.act_window">
        <field name="name">Species</field>
        <field name="res_model">vet.species</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_vet_breed_tree" model="ir.ui.view">
        <field name="name">vet.breed.tree</field>
        <field name="model">vet.breed</field>
        <field name="arch" type="xml">
            <list string="Breeds" editable="bottom">
                <field name="name"/>
                <field name="species_id"/>
                <field name="average_weight"/>
                <field name="life_expectancy"/>
            </list>
        </field>
    </record>

    <record id="action_vet_breed" model="ir.actions.act_window">
        <field name="name">Breeds</field>
        <field name="res_model">vet.breed</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
