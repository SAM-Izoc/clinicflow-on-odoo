<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Appointment Tree View -->
    <record id="view_vet_appointment_tree" model="ir.ui.view">
        <field name="name">vet.appointment.tree</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" sample="1">
                <field name="name"/>
                <field name="date_time"/>
                <field name="patient_id"/>
                <field name="owner_id"/>
                <field name="vet_id"/>
                <field name="appointment_type_id"/>
                <field name="status" decoration-danger="status == 'cancelled'" decoration-success="status == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- Appointment Form View -->
    <record id="view_vet_appointment_form" model="ir.ui.view">
        <field name="name">vet.appointment.form</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="status != 'scheduled'" class="oe_highlight"/>
                    <button name="action_start" type="object" string="Start" invisible="status != 'confirmed'" class="oe_highlight"/>
                    <button name="action_complete" type="object" string="Complete" invisible="status != 'in_progress'" class="oe_highlight"/>
                    <button name="action_create_medical_record" type="object" string="Create Medical Record" invisible="status != 'completed'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status not in ('scheduled', 'confirmed')" class="oe_link"/>
                    <button name="action_no_show" type="object" string="No Show" invisible="status not in ('scheduled', 'confirmed')" class="oe_link"/>
                    <field name="status" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="send_reminder" type="object" class="oe_stat_button" icon="fa-bell">
                            <span>Send Reminder</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Appointment Details">
                            <field name="date_time" required="1"/>
                            <field name="end_time" readonly="1"/>
                            <field name="duration" readonly="1"/>
                            <field name="appointment_type_id" required="1"/>
                        </group>
                        <group string="Provider &amp; Location">
                            <field name="vet_id" required="1"/>
                        </group>
                    </group>

                    <group string="Patient Information">
                        <group>
                            <field name="patient_id" required="1" readonly="id"/>
                            <field name="owner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason" placeholder="Reason for visit..." required="1"/>
                            <field name="symptoms" placeholder="Symptoms or concerns..."/>
                        </group>
                    </group>

                    <group string="Medical Record">
                        <field name="medical_record_id" readonly="1"/>
                    </group>

                    <group string="Communication &amp; Reminders">
                        <field name="reminder_sent"/>
                        <field name="reminder_date" invisible="not reminder_sent"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Appointment Calendar View -->
    <record id="view_vet_appointment_calendar" model="ir.ui.view">
        <field name="name">vet.appointment.calendar</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="date_time" date_stop="end_time" color="vet_id">
                <field name="patient_id"/>
                <field name="owner_id"/>
                <field name="vet_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <!-- Appointment Search View -->
    <record id="view_vet_appointment_search" model="ir.ui.view">
        <field name="name">vet.appointment.search</field>
        <field name="model">vet.appointment</field>
        <field name="arch" type="xml">
            <search string="Appointments">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="owner_id"/>
                <field name="vet_id"/>
                <field name="appointment_type_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date_time', '&gt;=', datetime.datetime.combine(context_today(), datetime.time.min)), ('date_time', '&lt;=', datetime.datetime.combine(context_today(), datetime.time.max))]"/>
                <filter string="Upcoming" name="upcoming" domain="[('date_time', '&gt;=', datetime.datetime.now()), ('status', '!=', 'cancelled')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <group>
                    <filter string="Veterinarian" name="vet" context="{'group_by': 'vet_id'}"/>
                    <filter string="Patient" name="patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="type" context="{'group_by': 'appointment_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Appointment Type Tree View -->
    <record id="view_vet_appointment_type_tree" model="ir.ui.view">
        <field name="name">vet.appointment_type.tree</field>
        <field name="model">vet.appointment_type</field>
        <field name="arch" type="xml">
            <list string="Appointment Types" editable="bottom">
                <field name="name"/>
                <field name="category"/>
                <field name="duration"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vet_appointment_type_form" model="ir.ui.view">
        <field name="name">vet.appointment_type.form</field>
        <field name="model">vet.appointment_type</field>
        <field name="arch" type="xml">
            <form string="Appointment Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="duration" help="Duration in minutes"/>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Appointment Type Action -->
    <record id="action_vet_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">vet.appointment_type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Appointment Actions -->
    <record id="action_vet_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">vet.appointment</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_vet_appointment_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

    <record id="action_vet_appointment_calendar" model="ir.actions.act_window">
        <field name="name">Appointment Calendar</field>
        <field name="res_model">vet.appointment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
