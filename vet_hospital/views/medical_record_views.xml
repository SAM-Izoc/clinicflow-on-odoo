<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medical Record Tree View -->
    <record id="view_vet_medical_record_tree" model="ir.ui.view">
        <field name="name">vet.medical_record.tree</field>
        <field name="model">vet.medical_record</field>
        <field name="arch" type="xml">
            <list string="Medical Records" sample="1">
                <field name="name"/>
                <field name="date_time"/>
                <field name="patient_id"/>
                <field name="owner_id"/>
                <field name="vet_id"/>
                <field name="primary_diagnosis_id"/>
                <field name="status" decoration-success="status == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- Medical Record Form View (SOAP) -->
    <record id="view_vet_medical_record_form" model="ir.ui.view">
        <field name="name">vet.medical_record.form</field>
        <field name="model">vet.medical_record</field>
        <field name="arch" type="xml">
            <form string="Medical Record">
                <header>
                    <button name="action_complete" type="object" string="Complete" invisible="status != 'draft'" class="oe_highlight"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" invisible="status != 'completed'" class="oe_highlight"/>
                    <button name="action_archive" type="object" string="Archive" invisible="status != 'completed'"/>
                    <field name="status" widget="statusbar" options="{'clickable': True}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Date &amp; Provider">
                            <field name="date_time"/>
                            <field name="vet_id"/>
                            <field name="appointment_id"/>
                        </group>
                        <group string="Patient Information">
                            <field name="patient_id"/>
                            <field name="owner_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- SOAP Section -->
                        <page string="SOAP Note" name="soap">
                            <group string="S - SUBJECTIVE (Chief Complaint &amp; History)">
                                <field name="subjective" placeholder="Patient history reported by owner, presenting complaint, symptoms, duration..." nolabel="1"/>
                            </group>

                            <group string="O - OBJECTIVE (Physical Exam &amp; Findings)">
                                <field name="objective" placeholder="Physical examination findings, observed signs, measurements, vital signs findings..." nolabel="1"/>
                            </group>

                            <group string="A - ASSESSMENT (Diagnosis)">
                                <separator string="Diagnoses"/>
                                <field name="diagnosis_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="category"/>
                                    </list>
                                </field>
                                <field name="primary_diagnosis_id"/>
                                <separator string="Assessment"/>
                                <field name="assessment" placeholder="Diagnostic impression, differential diagnoses considered..." nolabel="1"/>
                                <field name="body_condition_score"/>
                            </group>

                            <group string="P - PLAN (Treatment &amp; Follow-up)">
                                <field name="plan" placeholder="Treatment plan, medications prescribed, recommendations, follow-up instructions..." nolabel="1"/>
                                <field name="follow_up_required"/>
                                <field name="follow_up_date" invisible="not follow_up_required"/>
                                <field name="follow_up_notes" invisible="not follow_up_required"/>
                            </group>
                        </page>

                        <!-- Vital Signs -->
                        <page string="Vital Signs" name="vitals">
                            <field name="vital_sign_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="date_time"/>
                                    <field name="temperature"/>
                                    <field name="heart_rate"/>
                                    <field name="respiration"/>
                                    <field name="weight"/>
                                </list>
                            </field>
                        </page>

                        <!-- Prescriptions -->
                        <page string="Prescriptions" name="prescriptions">
                            <field name="prescription_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="medication_name"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="quantity"/>
                                    <field name="duration"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <!-- Lab Results -->
                        <page string="Lab Results" name="lab_results">
                            <field name="lab_result_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="test_type"/>
                                    <field name="date"/>
                                    <field name="result"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <!-- Attachments -->
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="mimetype"/>
                                    <field name="file_size"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>

                        <!-- Billing -->
                        <page string="Billing" name="billing">
                            <group>
                                <field name="invoice_id"/>
                            </group>
                        </page>

                        <!-- Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Medical Record Search View -->
    <record id="view_vet_medical_record_search" model="ir.ui.view">
        <field name="name">vet.medical_record.search</field>
        <field name="model">vet.medical_record</field>
        <field name="arch" type="xml">
            <search string="Medical Records">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="owner_id"/>
                <field name="vet_id"/>
                <field name="primary_diagnosis_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Follow-up Required" name="followup" domain="[('follow_up_required', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Patient" name="patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Veterinarian" name="vet" context="{'group_by': 'vet_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="date" context="{'group_by': 'date_time'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Diagnosis Tree/Form -->
    <record id="view_vet_diagnosis_tree" model="ir.ui.view">
        <field name="name">vet.diagnosis.tree</field>
        <field name="model">vet.diagnosis</field>
        <field name="arch" type="xml">
            <list string="Diagnoses" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
            </list>
        </field>
    </record>

    <record id="view_vet_diagnosis_form" model="ir.ui.view">
        <field name="name">vet.diagnosis.form</field>
        <field name="model">vet.diagnosis</field>
        <field name="arch" type="xml">
            <form string="Diagnosis">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vet_diagnosis" model="ir.actions.act_window">
        <field name="name">Diagnosis Codes</field>
        <field name="res_model">vet.diagnosis</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Medical Record Action -->
    <record id="action_vet_medical_record" model="ir.actions.act_window">
        <field name="name">Medical Records</field>
        <field name="res_model">vet.medical_record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vet_medical_record_search"/>
    </record>
</odoo>
