<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Actions (records first) -->
        <record id="action_clinicflow_pet" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">clinicflow.pet</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register a new pet patient!
                </p>
            </field>
        </record>

        <!-- Recent Patients Server Action -->
        <record id="action_clinicflow_pet_recent" model="ir.actions.server">
            <field name="name">Recent Patients</field>
            <field name="model_id" ref="model_clinicflow_pet"/>
            <field name="state">code</field>
            <field name="code">
                action = env.user.action_view_recent_pets()
            </field>
        </record>

        <record id="action_clinicflow_admission" model="ir.actions.act_window">
            <field name="name">Hospitalizations</field>
            <field name="res_model">clinicflow.admission</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Record a new pet hospitalization stay.
                </p>
            </field>
        </record>

        <!-- Operations Actions (Global Lists) -->
        <record id="action_clinicflow_visit_global" model="ir.actions.act_window">
            <field name="name">Global Visits</field>
            <field name="res_model">clinicflow.visit</field>
            <field name="view_mode">list,form,calendar</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Log or manage clinic visits.
                </p>
            </field>
        </record>

        <record id="action_clinicflow_vaccination_global" model="ir.actions.act_window">
            <field name="name">Global Vaccinations</field>
            <field name="res_model">clinicflow.vaccination</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Record vaccine administrations.
                </p>
            </field>
        </record>

        <record id="action_clinicflow_prescription_global" model="ir.actions.act_window">
            <field name="name">Global Prescriptions</field>
            <field name="res_model">clinicflow.prescription</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Write clinical prescriptions.
                </p>
            </field>
        </record>

        <!-- Dashboard Server Action -->
        <record id="action_clinicflow_dashboard_open" model="ir.actions.server">
            <field name="name">Operations Dashboard</field>
            <field name="model_id" ref="model_clinicflow_dashboard"/>
            <field name="state">code</field>
            <field name="code">
                action = env['clinicflow.dashboard'].action_open_dashboard()
            </field>
        </record>

        <!-- Top-level Menu -->
        <menuitem id="menu_clinicflow_root" name="ClinicFlow" sequence="5"/>



        <!-- Primary Menus -->
        <!-- Dashboards Menu -->
        <menuitem id="menu_clinicflow_dashboard" name="Dashboards" parent="menu_clinicflow_root" action="action_clinicflow_dashboard_open" sequence="30"/>
        <menuitem id="menu_clinicflow_patients" name="Patients" parent="menu_clinicflow_root" action="action_clinicflow_pet" sequence="10"/>
        
        <!-- Recent Patients (points to the recent patients server action) -->
        <menuitem id="menu_clinicflow_patients_recent" name="Recent Patients" parent="menu_clinicflow_root" action="action_clinicflow_pet_recent" sequence="12"/>
        
        <!-- Appointments (pointing to Odoo calendar.action_calendar_event) -->
        <menuitem id="menu_clinicflow_appointments" name="Appointments" parent="menu_clinicflow_root" action="calendar.action_calendar_event" sequence="15"/>
        
        <menuitem id="menu_clinicflow_admissions" name="Hospitalizations" parent="menu_clinicflow_root" action="action_clinicflow_admission" sequence="20"/>
        
        <!-- Billing (pointing to Odoo account.action_move_out_invoice_type) -->
        <menuitem id="menu_clinicflow_billing" name="Billing" parent="menu_clinicflow_root" action="account.action_move_out_invoice_type" sequence="25"/>

        

        <!-- Operations Submenu (Global lists for managers) -->
        <menuitem id="menu_clinicflow_operations_root" name="Operations" parent="menu_clinicflow_root" sequence="100"/>
        <menuitem id="menu_clinicflow_visits_global" name="Visits" parent="menu_clinicflow_operations_root" action="action_clinicflow_visit_global" sequence="10"/>
        <menuitem id="menu_clinicflow_vaccinations_global" name="Vaccinations" parent="menu_clinicflow_operations_root" action="action_clinicflow_vaccination_global" sequence="20"/>
        <menuitem id="menu_clinicflow_prescriptions_global" name="Prescriptions" parent="menu_clinicflow_operations_root" action="action_clinicflow_prescription_global" sequence="30"/>
    </data>
</odoo>
