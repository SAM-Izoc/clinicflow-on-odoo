<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Calendar Event Form View -->
    <record id="view_calendar_event_form_clinicflow" model="ir.ui.view">
        <field name="name">calendar.event.form.clinicflow</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- Inject Check In Pet / View Visit Buttons in Header -->
            <xpath expr="//header" position="inside">
                <button name="action_check_in_pet" string="Check In / Create Visit" type="object" class="oe_highlight" invisible="not pet_id or visit_id"/>
                <button name="action_check_in_pet" string="View Visit" type="object" class="btn-secondary" invisible="not visit_id"/>
            </xpath>
            
            <!-- Place Pet, Status, and Visit fields inside sheet -->
            <xpath expr="//field[@name='location']" position="before">
                <field name="pet_id" options="{'no_create': True}"/>
                <field name="appointment_status" widget="badge"/>
                <field name="visit_id" invisible="not visit_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Calendar Event Calendar View -->
    <record id="view_calendar_event_calendar_clinicflow" model="ir.ui.view">
        <field name="name">calendar.event.calendar.clinicflow</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <!-- Add Pet name with paw icon and appointment status on calendar card -->
            <xpath expr="//field[@name='location']" position="before">
                <field name="pet_id" invisible="not pet_id" options="{'icon': 'fa fa-paw'}"/>
                <field name="appointment_status" invisible="not appointment_status"/>
            </xpath>
        </field>
    </record>
</odoo>
