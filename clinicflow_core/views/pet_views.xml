<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_clinicflow_pet_tree" model="ir.ui.view">
        <field name="name">clinicflow.pet.list</field>
        <field name="model">clinicflow.pet</field>
        <field name="arch" type="xml">
            <list string="Pets">
                <field name="name"/>
                <field name="species"/>
                <field name="breed"/>
                <field name="gender"/>
                <field name="age_display" string="Age"/>
                <field name="owner_id"/>
                <field name="last_visit_date"/>
                <field name="last_weight"/>
                <field name="outstanding_balance" sum="Total Outstanding"/>
                <field name="upcoming_appointment_date"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_clinicflow_pet_search" model="ir.ui.view">
        <field name="name">clinicflow.pet.search</field>
        <field name="model">clinicflow.pet</field>
        <field name="arch" type="xml">
            <search string="Search Pets">
                <field name="name" string="Pet Name"/>
                <field name="owner_id" string="Owner"/>
                <field name="microchip" string="Microchip"/>
                <filter string="Dogs" name="dogs" domain="[('species', '=', 'dog')]"/>
                <filter string="Cats" name="cats" domain="[('species', '=', 'cat')]"/>
                <separator/>
                <filter string="Has Outstanding Balance" name="has_balance" domain="[('outstanding_balance', '&gt;', 0)]"/>
                <filter string="Has Upcoming Appointment" name="has_appointment" domain="[('upcoming_appointment_date', '!=', False)]"/>
                <separator/>
                <filter string="Group by Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                <filter string="Group by Species" name="group_species" context="{'group_by': 'species'}"/>
            </search>
        </field>
    </record>

    <!-- Form View (Patient 360 Workspace) -->
    <record id="view_clinicflow_pet_form" model="ir.ui.view">
        <field name="name">clinicflow.pet.form</field>
        <field name="model">clinicflow.pet</field>
        <field name="arch" type="xml">
            <form string="Pet">
                <!-- Quick Actions Header (CTO feedback - rapid workflow actions) -->
                <header>
                    <button name="action_create_appointment_quick" string="+ New Appointment" type="object" class="btn btn-secondary"/>
                    <button name="action_create_visit_quick" string="+ New Visit" type="object" class="btn btn-secondary"/>
                    <button name="action_create_prescription_quick" string="+ New Prescription" type="object" class="btn btn-secondary"/>
                    <button name="action_create_vaccination_quick" string="+ New Vaccination" type="object" class="btn btn-secondary"/>
                    <button name="action_create_admission_quick" string="+ Admit Patient" type="object" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <!-- Smart Button Box -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_weight_history" type="object" class="oe_stat_button" icon="fa-balance-scale">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="last_weight_display"/></span>
                                <span class="o_stat_text">Weight Logs (<field name="weight_count"/>)</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>

                    <field name="photo" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'photo'}"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Pet Name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bella"/>
                        </h1>
                    </div>

                    <!-- Patient Alerts & Warnings Banner (CTO feedback - prominent top placement) -->
                    <div class="alert alert-danger mb-2 p-2" role="alert" invisible="not alerts" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; font-size: 14px; font-weight: bold;">
                        <span class="fa fa-exclamation-triangle me-2"/>CRITICAL ALERT: <field name="alerts" readonly="1"/>
                    </div>
                    <div class="alert alert-warning mb-2 p-2" role="alert" invisible="not allergies" style="color: #856404; background-color: #fff3cd; border-color: #ffeeba; font-size: 14px; font-weight: bold;">
                        <span class="fa fa-warning me-2"/>ALLERGY WARNING: <field name="allergies" readonly="1"/>
                    </div>

                    <!-- Patient Summary Header (CTO feedback - persistent header) -->
                    <group>
                        <group string="Quick Details">
                            <field name="species"/>
                            <field name="breed"/>
                            <field name="gender"/>
                            <field name="age_display" readonly="1"/>
                        </group>
                        <group string="Owner &amp; Warnings">
                            <field name="owner_id"/>
                            <field name="emergency_contact"/>
                            <field name="alerts" placeholder="No clinical alerts" style="color: red; font-weight: bold;"/>
                        </group>
                    </group>

                    <!-- Patient 360 Notebook Workspace -->
                    <notebook>
                        <!-- Tab 1: Profile & Weights -->
                        <page string="Profile" name="profile">
                            <group string="Weight History">
                                <field name="weight_ids" nolabel="1">
                                    <list string="Weight Records" editable="bottom">
                                        <field name="date"/>
                                        <field name="weight"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </group>
                            <group string="General Info">
                                <field name="notes" placeholder="Enter other general notes here..."/>
                                <field name="microchip"/>
                            </group>
                        </page>

                        <!-- Tab 2: Persistent Health Info -->
                        <page string="Medical History" name="medical_history">
                            <group>
                                <field name="chronic_conditions" placeholder="e.g. Diabetes, Hip Dysplasia..."/>
                                <field name="allergies" placeholder="e.g. Penicillin allergy, Chicken protein..."/>
                                <field name="surgical_history" placeholder="e.g. Neutered on 2024-05-12, Fracture repair on 2025-08-01..."/>
                            </group>
                        </page>

                        <!-- Tab 3: Clinic Visits -->
                        <page string="Visits" name="visits">
                            <field name="visit_ids" readonly="1">
                                <list string="Visits">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="vet_id"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 4: Vaccination logs -->
                        <page string="Vaccinations" name="vaccinations">
                            <field name="vaccination_ids" readonly="1">
                                <list string="Vaccinations">
                                    <field name="vaccine_product_id"/>
                                    <field name="date_administered"/>
                                    <field name="date_due"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 5: Prescription history -->
                        <page string="Prescriptions" name="prescriptions">
                            <field name="prescription_ids" readonly="1">
                                <list string="Prescriptions">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 6: Hospitalizations -->
                        <page string="Hospitalizations" name="hospitalizations">
                            <field name="admission_ids" readonly="1">
                                <list string="Hospitalizations">
                                    <field name="name"/>
                                    <field name="admission_date"/>
                                    <field name="discharge_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 7: Billing & Invoices -->
                        <page string="Billing &amp; Invoices" name="billing">
                            <field name="invoice_ids" readonly="1">
                                <list string="Invoices">
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" sum="Total Invoiced"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 8: Documents / ir.attachment -->
                        <page string="Documents" name="documents">
                            <field name="attachment_ids">
                                <list string="Documents" editable="bottom">
                                    <field name="name"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="type"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 9: Chronological Timeline Events -->
                        <page string="Timeline" name="timeline">
                            <field name="timeline_ids" readonly="1">
                                <kanban class="o_kanban_mobile" create="false" delete="false">
                                    <field name="event_type"/>
                                    <field name="event_date"/>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex align-items-center p-2 mb-2 border rounded shadow-sm bg-white" style="border-left: 5px solid #007bff !important;">
                                                <!-- Left Col: Icon based on type -->
                                                <div class="me-3 text-center" style="width: 40px;">
                                                    <t t-if="record.event_type.raw_value == 'visit'">
                                                        <span class="fa fa-stethoscope text-primary fa-lg" title="Visit"/>
                                                    </t>
                                                    <t t-elif="record.event_type.raw_value == 'vaccination'">
                                                        <span class="fa fa-shield text-success fa-lg" title="Vaccination"/>
                                                    </t>
                                                    <t t-elif="record.event_type.raw_value == 'prescription'">
                                                        <span class="fa fa-medkit text-warning fa-lg" title="Prescription"/>
                                                    </t>
                                                    <t t-elif="record.event_type.raw_value == 'invoice'">
                                                        <span class="fa fa-credit-card text-info fa-lg" title="Invoice"/>
                                                    </t>
                                                    <t t-elif="record.event_type.raw_value == 'admission'">
                                                        <span class="fa fa-hospital-o text-danger fa-lg" title="Admission"/>
                                                    </t>
                                                </div>
                                                
                                                <!-- Right Col: Event content -->
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between">
                                                        <strong class="text-dark"><field name="name"/></strong>
                                                        <span class="text-muted small"><field name="event_date"/></span>
                                                    </div>
                                                    <div class="text-muted small mt-1">
                                                        <span class="fa fa-user me-1"/>Logged by: <field name="user_id"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
