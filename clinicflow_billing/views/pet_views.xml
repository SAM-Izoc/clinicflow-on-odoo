<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Tree View -->
    <record id="view_clinicflow_pet_tree_billing" model="ir.ui.view">
        <field name="name">clinicflow.pet.list.billing</field>
        <field name="model">clinicflow.pet</field>
        <field name="inherit_id" ref="clinicflow_patient.view_clinicflow_pet_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='last_weight']" position="after">
                <field name="outstanding_balance" sum="Total Outstanding"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Search View -->
    <record id="view_clinicflow_pet_search_billing" model="ir.ui.view">
        <field name="name">clinicflow.pet.search.billing</field>
        <field name="model">clinicflow.pet</field>
        <field name="inherit_id" ref="clinicflow_patient.view_clinicflow_pet_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='cats']" position="after">
                <separator/>
                <filter string="Has Outstanding Balance" name="has_balance" domain="[('outstanding_balance', '&gt;', 0)]"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Form View (Inject Invoices smart button and notebook tab) -->
    <record id="view_clinicflow_pet_form_billing" model="ir.ui.view">
        <field name="name">clinicflow.pet.form.billing</field>
        <field name="model">clinicflow.pet</field>
        <field name="inherit_id" ref="clinicflow_patient.view_clinicflow_pet_form"/>
        <field name="arch" type="xml">
            <!-- Add smart button to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-credit-card">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Invoices</span>
                    </div>
                </button>
            </xpath>

            <!-- Inject Billing Notebook Page -->
            <xpath expr="//notebook" position="inside">
                <page string="Billing &amp; Invoices" name="billing">
                    <field name="invoice_ids" readonly="1">
                        <list string="Invoices">
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="amount_total" sum="Total Invoiced"/>
                            <field name="payment_state" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
