<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Log Tree View -->
    <record id="view_clinicflow_outreach_log_tree" model="ir.ui.view">
        <field name="name">clinicflow.outreach.log.tree</field>
        <field name="model">clinicflow.outreach.log</field>
        <field name="arch" type="xml">
            <list string="Outreach Message Logs" create="false" edit="false">
                <field name="create_date" string="Date Created"/>
                <field name="partner_id"/>
                <field name="pet_id"/>
                <field name="vaccination_id"/>
                <field name="channel" widget="badge"/>
                <field name="recipient"/>
                <field name="state" widget="badge" decoration-info="state in ['draft', 'queued']" decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_clinicflow_outreach_log_form" model="ir.ui.view">
        <field name="name">clinicflow.outreach.log.form</field>
        <field name="model">clinicflow.outreach.log</field>
        <field name="arch" type="xml">
            <form string="Outreach Message Log" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,sent,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="pet_id" readonly="1"/>
                            <field name="vaccination_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="channel" readonly="1"/>
                            <field name="recipient" readonly="1"/>
                            <field name="date_sent" readonly="1" invisible="not date_sent"/>
                        </group>
                    </group>
                    <group string="Message Payload">
                        <field name="message_body" readonly="1" colspan="2"/>
                    </group>
                    <group string="Transmission Errors" invisible="state != 'failed'">
                        <field name="error_message" readonly="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Log Action -->
    <record id="action_clinicflow_outreach_log" model="ir.actions.act_window">
        <field name="name">Outreach Logs</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">clinicflow.outreach.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Outreach & Reminders parent menu (for activity/logs, not templates) -->
    <menuitem id="menu_clinicflow_outreach_root"
              name="Outreach &amp; Reminders"
              parent="clinicflow_core.menu_clinicflow_root"
              sequence="35"/>

    <!-- Outreach Logs sub-menu -->
    <menuitem id="menu_clinicflow_outreach_log"
              name="Outreach Logs"
              parent="menu_clinicflow_outreach_root"
              action="action_clinicflow_outreach_log"
              sequence="10"/>
</odoo>
