<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF Report Action -->
    <record id="action_report_daily_activity" model="ir.actions.report">
        <field name="name">Daily Practice Activity Summary</field>
        <field name="model">clinicflow.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinicflow_clinical.report_daily_activity_template</field>
        <field name="report_file">clinicflow_clinical.report_daily_activity_template</field>
        <field name="binding_model_id" ref="model_clinicflow_visit"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_daily_activity_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mb-4" style="border-bottom: 2px solid #007bff; padding-bottom: 10px;">
                        <h2>ClinicFlow Vet OS</h2>
                        <h3>Daily Practice Activity Summary</h3>
                        <h5 t-esc="context_today().strftime('%B %d, %Y')"/>
                    </div>

                    <h4 class="mt-4 text-primary">Logged Visits</h4>
                    <table class="table table-sm table-striped mt-2">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Pet Patient</th>
                                <th>Owner</th>
                                <th>Veterinarian</th>
                                <th>Visit Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td><strong><span t-field="doc.name"/></strong></td>
                                    <td><span t-field="doc.pet_id.name"/> (<span t-field="doc.pet_id.species"/>)</td>
                                    <td><span t-field="doc.owner_id.name"/></td>
                                    <td><span t-field="doc.vet_id.name"/></td>
                                    <td><span t-field="doc.date"/></td>
                                    <td><span t-field="doc.status"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
